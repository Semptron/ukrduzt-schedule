# VCS
.git
.gitignore
.github

# Python caches & venvs
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
.mypy_cache/

# Local runtime data — must NOT be baked into the image
data/
downloads/

# Docs & dev-only files
*.md
LICENSE
tests/
# requirements.txt is consumed in the builder stage; the runtime stage does
# not need it (deps are already copied from /root/.local).
requirements.txt

# Editor / OS noise
.DS_Store
.idea/
.vscode/
